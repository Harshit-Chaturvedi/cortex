# Add keys for whichever providers you have. The system tries them
# in order and falls back automatically if one runs out of quota.
# You only need ONE key to work, but more = more resilience.

# Google Gemini (free, no credit card) — get at aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (free tier) — get at console.groq.com/keys
GROQ_API_KEY=

# HuggingFace (free) — get at huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI (paid, needs credits) — get at platform.openai.com/api-keys
OPENAI_API_KEY=

# API key for protecting your Cortex endpoints
CORTEX_API_KEY=dev-key-change-me
